---
import { site } from '../data/site.ts';
---

<header class="site-header">
  <div class="container">
    <a href="/" class="logo">{site.name}</a>
    <nav>
      {site.nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: #0f172a;
    color: #fff;
    padding: 1rem 0;
  }
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo {
    font-weight: 800;
    font-size: 1.25rem;
    color: #fff;
    text-decoration: none;
  }
  nav a {
    color: #cbd5e1;
    text-decoration: none;
    margin-left: 1.25rem;
    font-size: 0.95rem;
  }
  nav a:hover {
    color: #fff;
  }
</style>
