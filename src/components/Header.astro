---
import { site } from '../data/site.ts';
---

<header class="site-header">
  <div class="container">
    <a href="/" class="nav-logo">
      <img src="/images/logo-vandiza.png" alt="Vandiza Tech" />
      <span class="nav-logo-text">{site.name}</span>
    </a>
    <nav>
      {site.nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <a href="/kontak" class="cta-small">Konsultasi</a>
  </div>
</header>

<style>
  .site-header {
    background: rgba(9, 9, 14, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 0.9rem 0;
  }
  .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .nav-logo { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; }
  .nav-logo img {
    height: 34px;
    transition: transform 0.25s ease, filter 0.25s ease;
    filter: drop-shadow(0 2px 6px rgba(5, 165, 186, 0.25));
  }
  .nav-logo:hover img {
    transform: scale(1.06);
    filter: drop-shadow(0 4px 12px rgba(5, 165, 186, 0.5));
  }
  .nav-logo-text { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1.15rem; color: var(--white); transition: color 0.25s ease; }
  .nav-logo:hover .nav-logo-text { color: var(--primary-light); }
  nav { display: flex; gap: 1.4rem; }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  nav a:hover { color: var(--white); }
  .cta-small {
    background: var(--primary-light);
    color: #04121a;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
  }
  @media (max-width: 768px) {
    nav { display: none; }
  }
</style>
