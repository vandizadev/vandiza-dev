---
import Base from '../layouts/Base.astro';
import { services } from '../data/services.ts';
import Icon from '../components/Icon.astro';
const s = services.find((x) => x.slug === 'keamanan')!;
---

<Base title={s.title} description={s.desc}>
  <section class="page">
    <div class="container">
      <div class="icon"><Icon name={s.icon} size={36} /></div>
      <h1>{s.title}</h1>
      <p class="lead">{s.desc}</p>
      <ul class="points">
        {s.points.map((p) => (
          <li><Icon name="check" size={18} class="check" /> {p}</li>
        ))}
      </ul>
      <a href="/kontak" class="btn-primary">Mulai Sekarang</a>
    </div>
  </section>
</Base>

<style>
  .page { padding: 6rem 0 5rem; }
  .container { max-width: 820px; margin: 0 auto; padding: 0 1.5rem; }
  .icon { color: var(--primary-light); margin-bottom: 1rem; display: flex; align-items: center; }
  h1 { font-size: 2.4rem; margin-bottom: 1rem; }
  .lead { color: var(--muted); font-size: 1.15rem; margin-bottom: 2rem; }
  .points { list-style: none; }
  .points li { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.85rem; font-size: 1.05rem; }
  .points li :global(.check) { color: var(--primary-light); flex-shrink: 0; }
  .btn-primary { display: inline-block; margin-top: 2rem; background: var(--primary-light); color: #04121a; padding: 0.8rem 1.75rem; border-radius: 10px; text-decoration: none; font-weight: 700; }
</style>
