---
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Vandiza CMS</title>
    <meta name="robots" content="noindex" />
    <script is:inline src="https://unpkg.com/decap-cms@3.3.3/dist/decap-cms.js"></script>
    <script is:inline>
      window.CMS_MANUAL_INIT = true;
    </script>
  </head>
  <body>
    <script is:inline>
      CMS.init({
        config: {
          backend: {
            name: 'github',
            repo: 'vandizadev/vandiza-dev',
            branch: 'main',
            base_url: 'https://www.vandiza.com',
            auth_endpoint: '/api/auth',
          },
          media_folder: 'public/images/uploads',
          public_folder: '/images/uploads',
          collections: [
            {
              name: 'blog',
              label: 'Blog & Artikel',
              folder: 'src/content/blog',
              create: true,
              slug: '{{slug}}',
              fields: [
                { name: 'title', label: 'Judul', widget: 'string' },
                { name: 'slug', label: 'Slug URL', widget: 'string', required: false },
                { name: 'description', label: 'Ringkasan', widget: 'text' },
                { name: 'cover', label: 'Cover', widget: 'image' },
                { name: 'tags', label: 'Tag', widget: 'list', required: false },
                { name: 'body', label: 'Isi', widget: 'markdown' },
              ],
            },
            {
              name: 'cases',
              label: 'Case Study',
              folder: 'src/content/cases',
              create: true,
              slug: '{{slug}}',
              fields: [
                { name: 'title', label: 'Judul', widget: 'string' },
                { name: 'client', label: 'Nama Klien', widget: 'string' },
                { name: 'result', label: 'Hasil', widget: 'text' },
                { name: 'quote', label: 'Testimoni', widget: 'text' },
                { name: 'body', label: 'Isi', widget: 'markdown' },
              ],
            },
          ],
        },
      });
    </script>
  </body>
</html>
