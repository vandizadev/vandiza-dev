---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.ts';
import { services } from '../data/services.ts';
import { testimonials } from '../data/testimonials.ts';
import Icon from '../components/Icon.astro';
---

<Base title={site.name} description={site.description}>
  <section class="hero">
    <div class="container">
      <span class="badge">Managed Service & SaaS Provider</span>
      <h1>{site.tagline}</h1>
      <p class="lead">{site.description}</p>
      <div class="cta">
        <a href="/kontak" class="btn-primary">Konsultasi Gratis</a>
        <a href="/saas" class="btn-secondary">Lihat Produk →</a>
      </div>
    </div>
  </section>

  <section class="pillars">
    <div class="container">
      <h2 class="section-title">3 Pilar Layanan</h2>
      <div class="grid">
        {services.map((s) => (
          <div class="card">
            <div class="icon"><Icon name={s.icon} size={32} /></div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <ul>
              {s.points.map((p) => (
                <li><Icon name="check" size={16} class="check" /> {p}</li>
              ))}
            </ul>
            <a href={`/${s.slug}`} class="link">Selengkapnya →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="testi">
    <div class="container">
      <h2 class="section-title">Dipercaya Operator & UMKM</h2>
      <div class="grid">
        {testimonials.map((t) => (
          <div class="tcard">
            <p class="quote">"{t.quote}"</p>
            <p class="name">{t.name}</p>
            <p class="role">{t.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: radial-gradient(circle at 20% 20%, #13131c, #09090e 60%);
    padding: 6rem 0 5rem;
    text-align: center;
  }
  .badge {
    display: inline-block;
    background: rgba(5, 165, 186, 0.15);
    color: var(--primary-light);
    border: 1px solid rgba(5, 165, 186, 0.3);
    padding: 0.4rem 1rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }
  h1 { font-size: 2.8rem; line-height: 1.15; margin-bottom: 1.25rem; max-width: 800px; margin-inline: auto; }
  .lead { color: var(--muted); font-size: 1.1rem; max-width: 680px; margin: 0 auto 2rem; }
  .cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .btn-primary, .btn-secondary {
    padding: 0.8rem 1.75rem; border-radius: 10px; text-decoration: none; font-weight: 700;
  }
  .btn-primary { background: var(--primary-light); color: #04121a; }
  .btn-secondary { border: 1px solid rgba(255,255,255,0.2); color: var(--white); }
  .pillars, .testi { padding: 5rem 0; }
  .section-title { font-size: 2rem; text-align: center; margin-bottom: 2.5rem; }
  .pillars .grid, .testi .grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;
  }
  .card {
    background: var(--ink2); border: 1px solid rgba(255,255,255,0.07); border-radius: 16px; padding: 1.75rem;
    transition: border-color 0.2s, transform 0.2s;
  }
  .card:hover { border-color: rgba(5,165,186,0.4); transform: translateY(-4px); }
  .icon { font-size: 2.2rem; margin-bottom: 1rem; color: var(--primary-light); display: flex; align-items: center; }
  .card h3 { font-size: 1.25rem; margin-bottom: 0.75rem; }
  .card p { color: var(--muted); font-size: 0.95rem; margin-bottom: 1rem; }
  .card ul { list-style: none; margin-bottom: 1.25rem; }
  .card ul li { display: flex; align-items: center; gap: 0.5rem; color: var(--white); font-size: 0.9rem; margin-bottom: 0.5rem; }
  .card ul li :global(.check) { color: var(--primary-light); flex-shrink: 0; }
  .link { color: var(--primary-light); text-decoration: none; font-weight: 600; font-size: 0.9rem; }
  .tcard { background: var(--ink2); border: 1px solid rgba(255,255,255,0.07); border-radius: 16px; padding: 1.75rem; }
  .quote { font-size: 1rem; margin-bottom: 1rem; }
  .name { font-weight: 700; font-family: 'Syne', sans-serif; }
  .role { color: var(--muted); font-size: 0.85rem; }
</style>
