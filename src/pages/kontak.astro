---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.ts';
import Icon from '../components/Icon.astro';
---

<Base title="Kontak" description="Hubungi Vandiza Tech">
  <section class="page">
    <div class="container">
      <h1>Konsultasi Gratis</h1>
      <p class="lead">Ceritakan kebutuhan infra/jaringan atau sistem digital Anda. Tim Vandiza akan balas dalam 1x24 jam.</p>
      <div class="contact">
        <a href={`https://wa.me/${site.contact.wa}`} class="btn-primary">
          <Icon name="whatsapp" size={20} /> WhatsApp
        </a>
        <a href={`mailto:${site.contact.email}`} class="btn-secondary">
          <Icon name="mail" size={20} /> Email
        </a>
      </div>
      <p class="geo">{site.geo}</p>
    </div>
  </section>
</Base>

<style>
  .page { padding: 6rem 0 5rem; }
  .container { max-width: 720px; margin: 0 auto; padding: 0 1.5rem; }
  h1 { font-size: 2.4rem; margin-bottom: 1rem; }
  .lead { color: var(--muted); margin-bottom: 2rem; }
  .contact { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .btn-primary, .btn-secondary {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.8rem 1.75rem; border-radius: 10px; text-decoration: none; font-weight: 700;
  }
  .btn-primary { background: #25D366; color: #fff; }
  .btn-secondary { border: 1px solid rgba(255,255,255,0.2); color: var(--white); }
  .geo { color: var(--muted); font-size: 0.95rem; }
</style>
