---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Meta helpers
const words = post.body ? post.body.split(/\s+/).filter(Boolean).length : 0;
const readMin = Math.max(1, Math.round(words / 200));
const rawDate = post.data.date;
const dateStr = rawDate ? new Date(rawDate).toLocaleDateString('id-ID', {
      day: 'numeric', month: 'long', year: 'numeric',
    }) : null;
const tags = post.data.tags || [];
---

<Base title={post.data.title} description={post.data.description}>
  <article class="post">
    <div class="container">
      <header class="post-head">
        <a href="/blog" class="crumb">← Kembali ke Blog</a>

        {tags.length > 0 && (
          <div class="tags">
            {tags.map((t) => <span class="tag">#{t}</span>)}
          </div>
        )}

        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>

        <div class="meta">
          {dateStr && <span class="meta-item">📅 {dateStr}</span>}
          <span class="meta-item">🕓 {readMin} menit baca</span>
          {post.data.author && <span class="meta-item">✍ {post.data.author}</span>}
        </div>

        <hr class="rule" />
      </header>

      <div class="content">
        <Content />
      </div>

      <aside class="cta-box">
        <h3>Butuh bantuan untuk bisnis Anda?</h3>
        <p>
          Konsultasi awal gratis — ceritakan kebutuhan website & digitalisasi,
          kami bantu petakan solusinya.
        </p>
        <a href="/kontak" class="btn-cta">Konsultasi Gratis</a>
      </aside>

      <footer class="post-foot">
        <a href="/blog" class="crumb">← Semua Artikel Blog</a>
      </footer>
    </div>
  </article>
</Base>

<style>
  .post { padding: 4.5rem 0 5rem; }
  .container { max-width: 760px; margin: 0 auto; padding: 0 1.5rem; }

  /* Breadcrumb */
  .crumb { color: var(--muted); text-decoration: none; font-size: 0.9rem; font-weight: 500; display: inline-block; margin-bottom: 1.75rem; transition: color 0.2s; }
  .crumb:hover { color: var(--primary-light); }

  /* Tags */
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
  .tag {
    background: rgba(5, 165, 186, 0.12);
    color: var(--primary-light);
    border: 1px solid rgba(5, 165, 186, 0.25);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  /* Title */
  h1 { font-size: 2.4rem; line-height: 1.2; margin-bottom: 1rem; letter-spacing: -0.01em; }
  .lede { color: var(--muted); font-size: 1.1rem; line-height: 1.6; margin-bottom: 1.5rem; }

  /* Meta row */
  .meta { display: flex; flex-wrap: wrap; gap: 1rem; color: var(--muted); font-size: 0.85rem; }
  .meta-item { display: inline-flex; align-items: center; }

  .rule { border: none; border-top: 1px solid rgba(255, 255, 255, 0.08); margin: 1.75rem 0 2.25rem; }

  /* Prose typography */
  .content { line-height: 1.85; font-size: 1.02rem; color: var(--white); }
  .content :global(h2) { margin: 2rem 0 0.9rem; font-size: 1.6rem; }
  .content :global(h3) { margin: 1.6rem 0 0.7rem; font-size: 1.25rem; }
  .content :global(p) { margin-bottom: 1.1rem; }
  .content :global(strong) { color: var(--white); }
  .content :global(blockquote) { border-left: 3px solid var(--primary-light); background: rgba(5,165,186,0.06); padding: 0.9rem 1.2rem; margin: 1.25rem 0; border-radius: 0 10px 10px 0; color: var(--muted); font-style: italic; }
  .content :global(ul), .content :global(ol) { margin: 0 0 1.25rem 1.4rem; }
  .content :global(li) { margin-bottom: 0.55rem; }
  .content :global(table) { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.95rem; }
  .content :global(th), .content :global(td) { border: 1px solid rgba(255,255,255,0.1); padding: 0.7rem 0.9rem; text-align: left; }
  .content :global(th) { background: rgba(5,165,186,0.1); color: var(--white); font-weight: 600; }
  .content :global(code) { background: rgba(255,255,255,0.08); padding: 0.1rem 0.4rem; border-radius: 5px; font-size: 0.9em; }

  /* CTA box */
  .cta-box {
    margin-top: 2.5rem;
    background: radial-gradient(circle at 85% 0%, rgba(5,165,186,0.15), rgba(19,19,28,0.6));
    border: 1px solid rgba(5,165,186,0.3);
    border-radius: 16px;
    padding: 1.75rem;
  }
  .cta-box h3 { font-size: 1.25rem; margin-bottom: 0.5rem; }
  .cta-box p { color: var(--muted); font-size: 0.95rem; margin-bottom: 1.25rem; }
  .btn-cta {
    display: inline-block;
    background: var(--primary-light);
    color: #04121a;
    padding: 0.7rem 1.5rem;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .btn-cta:hover { filter: brightness(1.1); }

  .post-foot { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.06); }
  .post-foot .crumb { margin-bottom: 0; }

  @media (max-width: 600px) {
    h1 { font-size: 1.9rem; }
    .container { padding: 0 1.25rem; }
  }
</style>