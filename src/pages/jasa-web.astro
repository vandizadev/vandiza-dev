---
import Base from '../layouts/Base.astro';
import { services } from '../data/services.ts';
const s = services.find((x) => x.slug === 'jasa-web')!;
---

<Base title={s.title} description={s.desc}>
  <section class="page">
    <div class="container">
      <div class="icon">{s.icon}</div>
      <h1>{s.title}</h1>
      <p class="lead">{s.desc}</p>
      <ul class="points">
        {s.points.map((p) => <li>{p}</li>)}
      </ul>
      <a href="/kontak" class="btn-primary">Mulai Sekarang</a>
    </div>
  </section>
</Base>

<style>
  .page { padding: 6rem 0 5rem; }
  .container { max-width: 820px; margin: 0 auto; padding: 0 1.5rem; }
  .icon { font-size: 3.5rem; margin-bottom: 1rem; }
  h1 { font-size: 2.4rem; margin-bottom: 1rem; }
  .lead { color: var(--muted); font-size: 1.15rem; margin-bottom: 2rem; }
  .points { list-style: none; }
  .points li { padding-left: 1.5rem; position: relative; margin-bottom: 0.75rem; font-size: 1.05rem; }
  .points li::before { content: "▸"; color: var(--primary-light); position: absolute; left: 0; }
  .btn-primary { display: inline-block; margin-top: 2rem; background: var(--primary-light); color: #04121a; padding: 0.8rem 1.75rem; border-radius: 10px; text-decoration: none; font-weight: 700; }
</style>
