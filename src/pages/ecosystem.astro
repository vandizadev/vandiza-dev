---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
const products = [
  { name: 'Velonix', desc: 'SaaS billing & manajemen pelanggan RT/RW Net otomatis.', href: '/saas', icon: 'satellite' },
  { name: 'Netsight', desc: 'Monitoring jaringan & OLT real-time untuk ISP mikro.', href: '/saas', icon: 'signal' },
  { name: 'Gasjoki', desc: 'Marketplace joki game dengan sistem escrow/rekber aman.', href: '/ecosystem', icon: 'game' },
];
---

<Base title="Ecosystem" description="Produk ekosistem Vandiza Tech">
  <section class="page">
    <div class="container">
      <h1 class="title">Produk Vandiza Tech</h1>
      <p class="lead">Kami tidak hanya jasa — kami juga membangun produk SaaS sendiri yang digunakan operator di seluruh Indonesia.</p>
      <div class="grid">
        {products.map((p) => (
          <a href={p.href} class="card">
            <div class="icon"><Icon name={p.icon} size={30} /></div>
            <h3>{p.name}</h3>
            <p>{p.desc}</p>
            <span class="link">Detail →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .page { padding: 6rem 0 5rem; }
  .container { max-width: 1000px; margin: 0 auto; padding: 0 1.5rem; }
  .title { font-size: 2.4rem; margin-bottom: 1rem; }
  .lead { color: var(--muted); margin-bottom: 2.5rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; }
  .card { background: var(--ink2); border: 1px solid rgba(255,255,255,0.07); border-radius: 16px; padding: 1.75rem; text-decoration: none; transition: border-color 0.2s; }
  .card:hover { border-color: rgba(5,165,186,0.4); }
  .icon { color: var(--primary-light); margin-bottom: 1rem; display: flex; align-items: center; }
  .card h3 { color: var(--primary-light); font-size: 1.3rem; margin-bottom: 0.5rem; }
  .card p { color: var(--muted); font-size: 0.95rem; margin-bottom: 1rem; }
  .link { color: var(--white); font-weight: 600; font-size: 0.9rem; }
</style>
